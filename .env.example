# URL del backend Spring Boot (una o varias separadas por coma, en orden de preferencia).
# En producción (Render) deja SOLO la de Render.
VITE_API_URL=http://localhost:8089

# URL del asistente con IA (bot-core, FastAPI + Gemini). DEBE terminar en /mastertech.
VITE_BOT_URL=http://localhost:8090/mastertech

# Mapa con pin para elegir la ubicación de entrega (opcional). Clave DE NAVEGADOR, distinta a la del servidor:
# solo "Maps JavaScript API" y restringida por referente HTTP (http://localhost:5173/* y tu dominio).
# Sin ella no se muestra el mapa; el buscador de direcciones sigue funcionando.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Opcional: ID de mapa propio (por defecto se usa DEMO_MAP_ID)
VITE_GOOGLE_MAP_ID=
