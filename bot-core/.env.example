# --- Gemini (solo en el servidor, nunca en el frontend) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Respaldo si el principal esta saturado (503) o no existe (404). Separados por coma.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# --- BD del bot: la MISMA base de Mastertech (Neon/Supabase), esquema "bot" (separado de "public") ---
# Neon: Connection string (puede ser la "pooled", host con -pooler). Supabase: Session pooler (5432) o Transaction pooler (6543).
BOT_DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST/DB?sslmode=require

# --- Auth: EXACTAMENTE el mismo valor que JWT_SECRET del backend Spring (minimo 32 caracteres) ---
BOT_JWT_SECRET=
BOT_JWT_ISSUER=                 # vacio: el JWT de Mastertech no lleva "iss"
BOT_JWT_ROLE_CLAIM=rol          # Mastertech: USER | ADMIN
BOT_JWT_NAME_CLAIM=nombre       # (el JWT no trae nombre; el bot lo lee de /api/v1/me)
BOT_JWT_DEFAULT_ROLE=USER

# --- Proyecto activo ---
BOT_PROJECT=mastertech
MASTERTECH_API_URL=http://localhost:8089     # backend Spring
# BOT_PROJECT=citas  +  CITAS_API_URL=http://localhost:8087   (proyecto original de citas, sigue disponible)

# --- Limites ---
BOT_RATE_LIMIT_PER_MIN=12
BOT_HISTORY_MESSAGES=16         # mensajes recientes que ve el modelo en cada turno (lo anterior se resume)
BOT_RESUME_DAYS=30              # el chat retoma la ultima conversacion si es mas reciente que estos dias
BOT_CORS_ORIGINS=http://localhost:5173       # URL(s) del frontend, separadas por coma
